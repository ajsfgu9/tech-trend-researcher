# ==============================================================================
# Tech Trend Researcher — Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Source Bot SQLite Databases (Read-Only Multi-DB Bridge)
# ------------------------------------------------------------------------------
# Format: comma-separated `bot_name=/container/path/to/db.sqlite` pairs.
# All 3 bots' Docker named volumes are mounted read-only into /data/... via
# docker-compose.yml (no need to convert your 3 bots to host bind mounts).
SOURCE_DB_SPECS=ai_hardware=/data/ai_hardware_bot/agi_hardware_trends.db,frontier_deeptech=/data/frontier_deeptech_bot/frontier_deeptech_trends.db,ai_software_stack=/data/ai_software_stack_quantum_bot/ai_stack_quantum_trends.db

# If the configured filename doesn't exist inside a mounted volume (for example,
# ai-hardware-bot's default fallback `agi_hardware_trends2.db`), automatically
# open the sole .db file found in that directory.
AUTO_DETECT_SINGLE_DB=true

# Exact Docker external volume names for docker-compose.yml.
# Run `docker volume ls` on your Ubuntu host to verify the exact names.
HARDWARE_BOT_VOLUME=ai-hardware-bot_bot-data
DEEPTECH_BOT_VOLUME=frontier-deeptech-bot_bot-data
SOFTWARE_BOT_VOLUME=ai-software-stack-quantum-bot_bot-data

# ------------------------------------------------------------------------------
# 2. Local State & Output Artifacts
# ------------------------------------------------------------------------------
STATE_DB_PATH=/app/data/researcher_state.db
OUTPUT_JSON_PATH=/app/data/trend_report.json
DASHBOARD_MD_PATH=/app/data/dashboard.md
HEALTHCHECK_FILE=/app/data/heartbeat.txt
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Dual-Provider LLM Configuration (Matches all 3 bots)
# ------------------------------------------------------------------------------
# Active primary provider: openrouter | gemini | none
LLM_PROVIDER=openrouter
# Optional automatic failover provider: gemini | openrouter | (blank to disable)
LLM_FALLBACK_PROVIDER=gemini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

GEMINI_API_KEY=
# Official Gemini API model (e.g. gemini-3.5-flash-lite, gemini-4-hydrogen)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional dense semantic embeddings via Gemini API (gemini-embedding-001).
# When false or GEMINI_API_KEY is unset, transparently uses corpus TF-IDF + BM25.
ENABLE_SEMANTIC_EMBEDDINGS=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------------------------
# 4. Live External Trend Collectors (Strictly External — Never Mixed With DBs)
# ------------------------------------------------------------------------------
ENABLE_HN_COLLECTOR=true
HN_MIN_POINTS=20
HN_MAX_ITEMS=40

ENABLE_GITHUB_COLLECTOR=true
# Optional Personal Access Token (raises GitHub search limit from 10 to 30 req/min)
GITHUB_TOKEN=
GITHUB_LOOKBACK_DAYS=14
GITHUB_MIN_STARS=25
GITHUB_MAX_ITEMS=30

ENABLE_HF_PAPERS_COLLECTOR=true
HF_PAPERS_MAX_ITEMS=30

ENABLE_LOBSTERS_COLLECTOR=true
LOBSTERS_MAX_ITEMS=30

# Optional authenticated social collectors (disabled automatically if keys are blank)
# Bluesky: uses authenticated PDS session (labeled honestly as `bluesky`, never X)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit OAuth (unauthenticated .json endpoints return HTTP 403)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=semiconductors,hardware,LocalLLaMA,MachineLearning,biotech,robotics,QuantumComputing

# Official X/Twitter API v2 Recent Search (requires X API v2 Bearer Token)
X_BEARER_TOKEN=
X_SEARCH_QUERIES=TSMC OR CoWoS OR HBM4 OR ASML,vLLM OR SGLang OR MoE OR Triton,CRISPR OR fusion OR humanoid robot

# ------------------------------------------------------------------------------
# 5. Trend Detection & DB Matching Tuning
# ------------------------------------------------------------------------------
EXTERNAL_LOOKBACK_HOURS=48
DB_LOOKBACK_HOURS=336
TOP_N_TRENDS=12
CLUSTER_SIMILARITY_THRESHOLD=0.28
DB_MATCH_THRESHOLD=0.32
MAX_LLM_TREND_ANALYSES=8
MAX_LLM_MATCH_VERIFICATIONS=15
MIN_DB_RELEVANCE_SCORE=7.0

# ------------------------------------------------------------------------------
# 6. Autonomous Dual-Trigger Daemon
# ------------------------------------------------------------------------------
DAEMON_MODE=true
SCHEDULE_INTERVAL_MINUTES=30
DB_WATCH_POLL_SECONDS=15

# ------------------------------------------------------------------------------
# 7. Telegram Bot Delivery (HTML-escaped)
# ------------------------------------------------------------------------------
ENABLE_TELEGRAM_NOTIFY=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_TELEGRAM_DOCUMENTS=true
