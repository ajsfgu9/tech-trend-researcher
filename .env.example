# Path to ai-hardware-bot SQLite database (read-only mount in Docker)
AI_HARDWARE_DB_PATH=/data/ai_hardware_bot/agi_hardware_trends.db

# Local SQLite stores & output files
RAW_DB_PATH=/app/data/raw_events.db
METADATA_DB_PATH=/app/data/metadata_repo.db
OUTPUT_JSON_PATH=/app/data/content_briefs.json
DASHBOARD_MD_PATH=/app/data/dashboard.md
HEALTHCHECK_FILE=/app/data/heartbeat.txt

# LLM Enrichment: openrouter | gemini | none
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=

# Autonomous Daemon & Dual-Trigger Configuration
DAEMON_MODE=true
SCHEDULE_INTERVAL_MINUTES=30
DB_WATCH_POLL_SECONDS=15

# Telegram Bot Duplication (sends both formatted message + full JSON/MD files)
ENABLE_TELEGRAM_NOTIFY=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_TELEGRAM_DOCUMENTS=true

# Pipeline tuning
LOOKBACK_HOURS=336
TOP_N_TRENDS=12
INGESTION_THRESHOLD_TAU=0.35
