# Path to ai-hardware-bot SQLite database (read-only mount in Docker)
AI_HARDWARE_DB_PATH=/data/ai_hardware_bot/agi_hardware_trends.db

# Output SQLite database & JSON feed for the downstream News Writer
TRENDS_DB_PATH=/app/data/tech_trends.db
OUTPUT_JSON_PATH=/app/data/trends_output.json

# LLM Enrichment: openrouter | gemini | none
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=

# Pipeline tuning
LOOKBACK_HOURS=72
TOP_N_TRENDS=12
EXCLUDE_SOURCES=Hacker News
